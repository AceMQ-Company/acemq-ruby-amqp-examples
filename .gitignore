.bundle/
vendor/bundle/

# Deliberately not committed. A lock file would pin the library's version and
# everything under it, and CI would run that resolution for ever — which is
# exactly the drift these examples exist to catch. Resolving afresh is what
# makes a weekly build tell us something.
Gemfile.lock

# Written by the TLS example and by etc/tls-broker.sh. Short-lived development
# certificates, and private keys besides; nothing here belongs in a repository.
certs/
*.crt
*.key
*.pem

# The claim-check store, written and removed by intermediate/08-claim-check. It
# is here for the run that fails before it gets to the removing.
intermediate/08-claim-check/payloads/

.DS_Store
